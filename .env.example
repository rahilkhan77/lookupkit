# Lookupkit local configuration
# Copy to .env and fill in. Never commit secrets.

# --- Core ---
# SQLite is the default. For Postgres via docker-compose, use:
# DATABASE_URL=postgresql+psycopg2://lookupkit:lookupkit@localhost:5432/lookupkit
DATABASE_URL=sqlite:///./lookupkit.db
# Optional Redis (rate limiting). Leave empty to disable.
REDIS_URL=
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=0
API_PUBLIC_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
# Signup trial credits
SIGNUP_CREDITS=100

# --- Optional data adapters (off when unset) ---
MILLIONVERIFIER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# MaxMind web service also needs an account id; adapter stays off if either is missing.
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=

# --- Stripe (TEST only by default) ---
# Must be sk_test_... unless STRIPE_LIVE=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 only if you intentionally accept live charges with an sk_live_ key.
STRIPE_LIVE=0
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard/billing?status=success
STRIPE_CANCEL_URL=http://localhost:3000/dashboard/billing?status=cancel

# --- Web ---
API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
